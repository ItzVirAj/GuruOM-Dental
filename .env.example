# Database connection strings (Neon Postgres)
# DATABASE_URL: Pooled connection string, used at runtime by the website using the LIMITED role (guruom_app)
DATABASE_URL="postgresql://guruom_app:REPLACE_WITH_LIMITED_ROLE_PASSWORD@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# DATABASE_URL_UNPOOLED: Direct (unpooled) connection string, used ONLY by migration scripts and schema tools with the owner role (neondb_owner)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:REPLACE_WITH_OWNER_ROLE_PASSWORD@ep-sample.region.neon.tech/neondb?sslmode=require"

# Secret owner URL path segment (random slug generated via `npm run owner:slug`, 20-64 chars, e.g. xk92-m8vn-49q1-pl80-3fa)
# Never use words like 'admin', 'dashboard', 'login', etc.
ADMIN_PATH="sample-secret-path-segment-24chars"

# Set to "true" only when the owner area scaffold is actively enabled
OWNER_AREA_ENABLED="false"

# Base public site URL
SITE_URL="http://localhost:3000"
