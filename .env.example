# Database connection strings (Neon Postgres)
# DATABASE_URL: Pooled connection string, used at runtime by the website using the LIMITED role (guruom_app)
DATABASE_URL="postgresql://guruom_app:REPLACE_WITH_LIMITED_ROLE_PASSWORD@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# DATABASE_URL_UNPOOLED: Direct (unpooled) connection string, used ONLY by migration scripts and schema tools with the owner role (neondb_owner)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:REPLACE_WITH_OWNER_ROLE_PASSWORD@ep-sample.region.neon.tech/neondb?sslmode=require"

# Secret owner URL path segment (random slug generated via `npm run owner:slug`, 20-64 chars, e.g. xk92-m8vn-49q1-pl80-3fa)
# Never use words like 'admin', 'dashboard', 'login', etc.
ADMIN_PATH="sample-secret-path-segment-24chars"

# Set to "true" only when the owner area scaffold is actively enabled
OWNER_AREA_ENABLED="false"

# Base public site URL
SITE_URL="http://localhost:3000"

# Better Auth Configuration
# Generate a fresh 32+ byte random secret via `npm run auth:secret`
# (Dev and production environments MUST use different secrets)
BETTER_AUTH_SECRET="REPLACE_WITH_BETTER_AUTH_SECRET_MIN_32_BYTES"
BETTER_AUTH_URL="http://localhost:3000"

# Optional Cloudflare Turnstile bot protection for owner login (disabled by default if omitted)
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Cloudinary Storage Configuration
# Cloud name used by both client-side next/image loader and server
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Asset folder ('guruom-dev' in development, 'guruom' in production)
CLOUDINARY_FOLDER="guruom-dev"
# Maximum upload byte size (default 4 MB: 4194304)
UPLOAD_MAX_BYTES=4194304
# Media library soft storage limit (default 300 MB: 314572800)
MEDIA_LIBRARY_MAX_BYTES=314572800
# Daily upload limit per owner (default 200)
DAILY_UPLOAD_LIMIT=200
